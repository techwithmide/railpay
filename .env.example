# ==========================================
# 1. CORE GATEWAY (cmd/arcpay)
# ==========================================
ARCPAY_ENV=dev
ARCPAY_ADDR=:8080
BASE_URL=http://localhost:8080
ARC_RPC_URL=https://rpc.testnet.arc.network
USDC_ADDRESS=0xfffffffffffffffffffffffffffffffffffffffe
START_BLOCK=0
PLATFORM_FEE_BPS=0
MIN_PAYOUT_USDC=0.01

# Optional in dev (falls back to memory store), required in production:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/arcpay?sslmode=disable

# ==========================================
# 2. LOCAL DEV CONVENIENCE (ARCPAY_ENV=dev)
# ==========================================
DERIVE_SECRET=dev-seed-phrase-or-random-32-byte-hex
DEV_API_KEY=sk_test_12345
DEV_WEBHOOK_URL=https://webhook.site/
DEV_WEBHOOK_SECRET=whsec_mysecretkey123
DEV_SETTLEMENT_ADDRESS=

# ==========================================
# 3. PRODUCTION SIGNER SERVICE (cmd/signer)
# ==========================================
SIGNER_URL=http://127.0.0.1:8081
SIGNER_TOKEN_ADDRESS=replace_with_random_32_char_token_address
SIGNER_TOKEN_SIGN=replace_with_random_32_char_token_sign_001
SIGNER_TOKEN_REGISTER=replace_with_random_32_char_token_register
SIGNER_TOKEN_APPROVE=replace_with_random_32_char_token_approve

# Signer daemon configuration:
CHAIN_ID=5042002
SIGNER_ADDR=127.0.0.1:8081
SIGNER_STATE_FILE=signer-state.json
SIGNER_AUDIT_FILE=signer-audit.jsonl
MAX_VALUE_USDC=10000
DAILY_CAP_USDC=50000
GLOBAL_DAILY_CAP_USDC=250000
MAX_FEE_GWEI=1000
DESTINATION_COOLDOWN=24h
REQUIRE_APPROVAL=true

# ==========================================
# 4. MERCHANT PORTAL & OAUTH
# ==========================================
STATE_SECRET=replace_with_random_32_char_secret_cookie_key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_ORIGINS=http://localhost:3000
DASHBOARD_URL=/
